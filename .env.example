# Tasador — plantilla de configuración.
# Copiar a .env y completar. NUNCA commitear .env.
#   cp .env.example .env

# ── Entorno ───────────────────────────────────────────────────────────────
# ⚠️ NADA de comentarios al final de una línea `CLAVE=valor`.
# `docker --env-file` NO los interpreta: se los lleva como parte del valor.
# Esta línea decía `ENV=development  # development | production` y en
# producción —donde el compose pasa `env_file: [.env]` sin pisar `ENV`— los
# cuatro servicios morían al arrancar con:
#     ValidationError: env  Input should be 'development', 'test' or 'production'
# En desarrollo no se veía porque el override declara `ENV: development`.
# Hay un test que falla si vuelve a aparecer un comentario en línea.
#
# development | test | production
ENV=development
DOMAIN=tasador.localhost
# Para el certificado TLS de Caddy (solo en producción)
ACME_EMAIL=admin@ejemplo.com.ar
LOG_LEVEL=INFO
TAG=dev
GH_OWNER=ricardobing

# ── Base de datos ─────────────────────────────────────────────────────────
POSTGRES_DB=tasador
POSTGRES_USER=tasador
POSTGRES_PASSWORD=cambiar-esto
DATABASE_URL=postgresql+psycopg://tasador:cambiar-esto@postgres:5432/tasador

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_PASSWORD=cambiar-esto
REDIS_URL=redis://:cambiar-esto@redis:6379/0

# ── Seguridad ─────────────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-esto-por-algo-aleatorio-de-48-bytes
# Clave maestra para cifrar credenciales de terceros en la base (pgcrypto)
ENCRYPTION_KEY=cambiar-esto-tambien

# ── LLM: todo pasa por LiteLLM (ADR-003) ──────────────────────────────────
# La app NUNCA habla directo con un proveedor. Solo con esta URL.
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=sk-cambiar-esto

# Claves de proveedores — las lee LiteLLM, no la app.
# Solo hace falta completar las que se usen en config/litellm.yaml.
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Observabilidad ────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SENTRY_DSN=

# ── Embeddings (locales, costo cero) ──────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# ── Ingesta ───────────────────────────────────────────────────────────────
# Qué portales alimentan ESTA instancia y con qué rótulo entran al corpus:
#   PORTALES=nombre-en-el-csv=PORTAL_A,otro=PORTAL_B
# De dónde salen los archivos es decisión de quien opera (docs/10 §2). Vacío =
# solo datasets públicos (BA Data) + inventario propio + carga manual.
PORTALES=

# Fuente externa OPCIONAL: el inventario del panel de la inmobiliaria, por un
# rol de SOLO LECTURA sobre vistas sin datos personales (docs/01 §2.2).
# En false el sistema funciona igual, sin ese inventario.
PANEL_SOURCE_ENABLED=false
PANEL_READONLY_DSN=

# ── Geocodificación ───────────────────────────────────────────────────────
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=Tasador/1.0 (contacto@ejemplo.com.ar)
GOOGLE_GEOCODING_API_KEY=

# ── Valuación ─────────────────────────────────────────────────────────────
MIN_COMPARABLES=5
MAX_CANDIDATES=60
CRITIC_MAX_RETRIES=2

# ── Backups ───────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tasador-backups
BACKUP_AGE_PUBLIC_KEY=

# ── Crons ─────────────────────────────────────────────────────────────────
CRON_SECRET=cambiar-esto
HEALTHCHECKS_PING_URL=
