{# Plantilla v2 del PDF (19/09/2026). Cambios respecto de v1, que salían de leer
   un informe real: el documento empezaba por la cifra sin decir qué propiedad
   era; la tabla de comparables, al mismo tamaño que el texto, se volvía el
   centro del informe. Ahora hay tres niveles de lectura: (1) la propiedad y el
   valor, en la primera página; (2) la narrativa; (3) el respaldo —los
   comparables, chicos, al final— y la trazabilidad.

   Sin recursos externos a propósito: ni fuentes, ni CSS, ni imágenes por URL.
   Un PDF que depende de la red falla en silencio cuando no hay red. #}
<!DOCTYPE html>
<html lang="es-AR">
<head>
<meta charset="utf-8">
<title>Informe de Mercado Comparativo — {{ direccion }}</title>
<style>
  @page {
    size: A4;
    margin: 18mm 17mm 20mm 17mm;
    @top-left {
      content: "{{ org }}";
      font: 600 8pt "Helvetica", sans-serif; color: #374151; letter-spacing: 0.04em;
    }
    @top-right {
      content: "Informe de Mercado Comparativo · {{ fecha }}";
      font: 8pt "Helvetica", sans-serif; color: #6b7280;
    }
    @bottom-left {
      content: "{{ direccion }}{% if barrio %} · {{ barrio }}{% endif %}";
      font: 7.5pt "Helvetica", sans-serif; color: #9ca3af;
    }
    @bottom-right {
      content: "Página " counter(page) " de " counter(pages);
      font: 7.5pt "Helvetica", sans-serif; color: #9ca3af;
    }
  }
  body { font: 10pt/1.5 "Helvetica", sans-serif; color: #111827; }
  h1 { font-size: 17pt; line-height: 1.2; margin: 0 0 1mm; letter-spacing: -0.01em; }
  h2 { font-size: 11.5pt; margin: 7mm 0 2mm; color: #1f2937; break-after: avoid; }
  h3 { font-size: 10pt; margin: 4mm 0 1.5mm; color: #374151; break-after: avoid; }
  p { margin: 0 0 2.6mm; }

  /* ── Nivel 1: la propiedad y el valor ─────────────────────────────── */
  .cabecera { color: #6b7280; font-size: 9pt; margin: 0 0 5mm; }
  .propiedad { border: 0.4pt solid #e5e7eb; border-radius: 2mm; padding: 4mm 5mm;
               margin: 0 0 4mm; break-inside: avoid; }
  .propiedad .titulo { font-size: 8pt; text-transform: uppercase; letter-spacing: 0.08em;
                       color: #6b7280; margin-bottom: 2mm; }
  .propiedad .direccion { font-size: 13pt; font-weight: bold; margin-bottom: 2.5mm; }
  .datos { display: flex; flex-wrap: wrap; gap: 1.6mm 6mm; font-size: 9pt; }
  .datos .d { min-width: 38mm; }
  .datos .k { color: #6b7280; }
  .datos .v { font-weight: 600; }
  .datos .v.nd { color: #9ca3af; font-weight: normal; font-style: italic; }

  .valor { display: flex; gap: 6mm; align-items: stretch; margin: 0 0 5mm;
           break-inside: avoid; }
  .valor .principal { flex: 1.3; background: #f3f7f5; border: 0.4pt solid #cfe3d9;
                      border-radius: 2mm; padding: 4.5mm 5mm; }
  .valor .principal .titulo { font-size: 8pt; text-transform: uppercase;
                              letter-spacing: 0.08em; color: #2f6b4f; }
  .valor .cifra { font-size: 24pt; font-weight: bold; color: #17452f; line-height: 1.15;
                  margin: 1mm 0 1.5mm; }
  .valor .rango { color: #374151; font-size: 9pt; }
  .valor .lateral { flex: 1; display: flex; flex-direction: column; gap: 2.5mm; }
  .tarjeta { border: 0.4pt solid #e5e7eb; border-radius: 2mm; padding: 3mm 4mm;
             font-size: 9pt; }
  .tarjeta .titulo { font-size: 7.5pt; text-transform: uppercase; letter-spacing: 0.08em;
                     color: #6b7280; }
  .tarjeta .dato { font-size: 12pt; font-weight: bold; margin-top: 0.5mm; }
  .chip { display: inline-block; padding: 0.4mm 2.2mm; border-radius: 3mm;
          font-size: 8.5pt; font-weight: bold; letter-spacing: 0.04em; }
  .chip.ALTA { background: #dcfce7; color: #166534; }
  .chip.MEDIA { background: #fef3c7; color: #92400e; }
  .chip.BAJA { background: #fee2e2; color: #991b1b; }
  .chip.otra { background: #e5e7eb; color: #374151; }

  .aviso { background: #fef3c7; border-left: 3pt solid #d97706;
           padding: 3.5mm 5mm; margin: 0 0 5mm; font-size: 9.5pt; break-inside: avoid; }

  /* ── Nivel 2: la narrativa ────────────────────────────────────────── */
  .narrativa h2 { border-bottom: 0.4pt solid #d1d5db; padding-bottom: 1.2mm; }
  .narrativa p { text-align: justify; }
  .narrativa ul, .narrativa ol { margin: 0 0 2.6mm; padding-left: 5mm; }
  .narrativa li { margin-bottom: 1mm; }

  /* ── Nivel 3: el respaldo ─────────────────────────────────────────── */
  .respaldo { margin-top: 8mm; padding-top: 4mm; border-top: 0.6pt solid #d1d5db; }
  .respaldo h2 { margin-top: 0; font-size: 10.5pt; color: #374151; }
  .respaldo .nota { font-size: 8pt; color: #6b7280; margin-bottom: 2.5mm; }
  table { width: 100%; border-collapse: collapse; font-size: 7pt; line-height: 1.3;
          margin: 0 0 4mm; color: #374151; }
  th { text-align: left; background: #f3f4f6; padding: 1.2mm 1.6mm;
       border-bottom: 0.5pt solid #d1d5db; font-weight: 600; font-size: 6.8pt;
       text-transform: uppercase; letter-spacing: 0.04em; color: #6b7280; }
  td { padding: 1mm 1.6mm; border-bottom: 0.3pt solid #eef0f3; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  tr.fuera td { color: #9ca3af; }
  tr.fuera td.motivo { font-style: italic; }
  thead { display: table-header-group; }  /* se repite al cortar la página */

  .pie { margin-top: 5mm; padding-top: 2.5mm; border-top: 0.4pt solid #e5e7eb;
         font-size: 7pt; color: #6b7280; line-height: 1.45; }
  .pie code { font-size: 6.6pt; }
</style>
</head>
<body>

<h1>Informe de Mercado Comparativo</h1>
<div class="cabecera">Preparado por {{ org }} · {{ fecha }}</div>

<div class="propiedad">
  <div class="titulo">La propiedad tasada</div>
  <div class="direccion">{{ direccion }}{% if barrio %} · {{ barrio }}{% endif %}</div>
  <div class="datos">
    {% for d in datos_propiedad %}
    <div class="d"><span class="k">{{ d.k }}: </span>
      {% if d.v is none %}<span class="v nd">sin declarar</span>{% else %}<span class="v">{{ d.v }}</span>{% endif %}
    </div>
    {% endfor %}
  </div>
</div>

<div class="valor">
  <div class="principal">
    <div class="titulo">Precio de publicación sugerido</div>
    <div class="cifra">{{ moneda }} {{ valor_medio }}</div>
    <div class="rango">
      Rango de confianza: {{ moneda }} {{ valor_min }} — {{ valor_max }}<br>
      Si publicás al valor sugerido, esperá cerrar entre {{ moneda }} {{ cierre_min }} y {{ cierre_max }}.
    </div>
  </div>
  <div class="lateral">
    <div class="tarjeta">
      <div class="titulo">Confianza</div>
      <div class="dato"><span class="chip {{ confianza if confianza in ('ALTA', 'MEDIA', 'BAJA') else 'otra' }}">{{ confianza }}</span>
        {% if confianza_score %}<span style="font-size:8pt; color:#6b7280; font-weight:normal;"> score {{ confianza_score }}</span>{% endif %}</div>
    </div>
    <div class="tarjeta">
      <div class="titulo">Respaldo</div>
      <div class="dato">{{ comparables_usados }} de {{ comparables_encontrados }}</div>
      <div style="font-size:8pt; color:#6b7280;">avisos comparables usados</div>
    </div>
    {% if usd_m2_sugerido %}
    <div class="tarjeta">
      <div class="titulo">Valor por m²</div>
      <div class="dato">{{ moneda }} {{ usd_m2_sugerido }}</div>
    </div>
    {% endif %}
  </div>
</div>

{% if confianza_baja %}
<div class="aviso">
  <strong>Confianza baja.</strong> Esta estimación se apoya en pocos comparables
  o en un mercado muy heterogéneo. Tomala como una referencia de orden de
  magnitud y no como un valor cerrado; la sección de limitaciones explica por qué.
</div>
{% endif %}

<div class="narrativa">
{{ narrativa_html }}
</div>

{% if comparables %}
<div class="respaldo">
  <h2>Respaldo: los {{ comparables_encontrados }} avisos analizados</h2>
  <div class="nota">Primero los {{ comparables_usados }} que sustentan el valor; después los descartados, cada uno con su motivo. Precios de publicación, no de cierre. «Ajustado» es el USD/m² llevado a las características de la propiedad tasada.</div>
  <table>
    <thead>
      <tr>
        <th>#</th><th>Origen</th><th>Dirección</th>
        <th class="num">Precio</th><th class="num">m²</th>
        <th class="num">USD/m²</th><th class="num">Ajustado</th>
        <th>Uso</th>
      </tr>
    </thead>
    <tbody>
    {% for c in comparables %}
      <tr class="{{ '' if c.included else 'fuera' }}">
        <td class="num">{{ loop.index }}</td>
        <td>{{ c.source }}</td>
        <td>{{ c.direccion or '—' }}</td>
        <td class="num">{{ c.precio }}</td>
        <td class="num">{{ c.superficie or '—' }}</td>
        <td class="num">{{ c.usd_m2 or '—' }}</td>
        <td class="num">{{ c.usd_m2_ajustado or '—' }}</td>
        <td class="motivo">{{ 'usado' if c.included else c.motivo }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}

{# La trazabilidad va IMPRESA, no escondida: es lo que permite auditar este
   documento seis meses después. #}
<div class="pie">
  Informe generado el {{ fecha }} · {{ comparables_usados }} de
  {{ comparables_encontrados }} avisos utilizados · confianza {{ confianza }}<br>
  Versiones — motor <code>{{ engine_version }}</code>,
  método <code>{{ method_version }}</code>,
  prompts <code>{{ prompt_bundle_version }}</code> · informe
  <code>{{ report_id }}</code><br>
  Los valores corresponden a precios de publicación, no de escrituración.
  Este informe no constituye una tasación con validez legal, que debe estar
  firmada por un martillero matriculado.
</div>

</body>
</html>
